# Copy to .env and enter credentials locally, never in chat or shell arguments.
MYSQL_HOST=your-service.aivencloud.com
MYSQL_PORT=3306
MYSQL_ADMIN_USER=avnadmin
MYSQL_ADMIN_PASS=
MYSQL_EVAL_USER=eval_readonly
MYSQL_EVAL_PASS=

# Download the CA from your Aiven service's connection information.
# Paths may be absolute, start with ~, or be relative to the repo root.
MYSQL_SSL_CA=~/Downloads/ca.pem
# For Modal, put the PEM certificate text in MYSQL_SSL_CA_PEM instead.
